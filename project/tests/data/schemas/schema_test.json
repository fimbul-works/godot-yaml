{
	"$schema": "https://json-schema.org/draft-07/schema",
	"type": "object",
	"patternProperties": {
		"^[a-zA-Z_][a-zA-Z0-9_]*$": {
			"$ref": "#/$defs/AnotherObject"
		}
	},
	"additionalProperties": false,
	"$defs": {
		"AnotherObject": {
			"type": "object",
			"required": [
				"id"
			],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[0-9]{2}$"
				}
			}
		}
	}
}
